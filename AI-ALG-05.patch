index 0000000..9e2faf3
--- /dev/null
+++ b/tests/unit/KeyLongEvidenceA05.verify.js
@@ -0,0 +1,28 @@
+/**
+ * AI-ALG-05 — Kiểm chứng bằng chứng Key dài hạn (nhạc pop TỔNG HỢP, KHÔNG phải nhạc thật).
+ * Chạy: node tests/unit/KeyLongEvidenceA05.verify.js
+ * Engine thật trong vm + đồng hồ ảo. Kiểm: (1) khoá ổn định (ít lần đổi), (2) cuối bài đúng tonic,
+ * (3) outOfScaleRatio phân biệt nốt trong/ngoài thang, (4) estimateKeyLong có mặt.
+ */
+const path = require('path');
+const REPO = path.resolve(__dirname, '../..');
+const { render, PROGS } = require(path.join(REPO, 'tests/helpers/synthPop.js'));
+const { mkAnalyser, sandbox, loadEngine } = require(path.join(REPO, 'tools/algbench/lib.js'));
+let fail = 0; const ok = (c, m) => { console.log(`  ${c ? '✅' : '❌'} ${m}`); if (!c) fail++; };
+function run(mode, prog, root, secs) {
+    const sr = 22050, r = render({ sr, seconds: secs + 1, mode, prog, root, seed: root * 13 + prog.length + 5 }); const clock = { t: 1000 };
+    const S = sandbox(clock, () => mkAnalyser(r.pcm, sr, 8192, clock, 1000), sr); loadEngine(REPO, S.sb, 'keyEngine.js', 'KeyEngine');
+    const K = S.sb.KeyEngine; K.init(S.ctx, { connect() {} }); const locks = [];
+    K.watchContinuous((res) => locks.push(res.key)); S.step(secs * 1000);
+    const out = { locks, last: K.estimateKeyFromChroma(), long: typeof K.estimateKeyLong === 'function' ? K.estimateKeyLong() : null, K, root: r.truth.root };
+    return out;
+}
+console.log('=== KeyLongEvidenceA05 (synthetic) ===');
+const prog = 'I-V-vi-IV'; // chuỗi hợp âm pop phổ biến; trước thay đổi dao động C Major <-> A Minor (8 lần/40 s)
+const a = run('major', prog, 0, 40);
+ok(typeof a.K.estimateKeyLong === 'function' && typeof a.K.outOfScaleRatio === 'function', 'API estimateKeyLong/outOfScaleRatio có mặt');
+ok(a.locks.length <= 3, `số lần đổi khoá ≤ 3 trong 40 s (thực tế ${a.locks.length}: ${a.locks.join(' > ')})`);
+ok(!!a.long && (a.long.rootIndex === 0 || a.long.rootIndex === 9), `Key dài hạn đúng tonic hoặc relative (root=${a.long && a.long.rootIndex})`);
+const inS = a.K.outOfScaleRatio(0, 'Major', 'short'), outS = a.K.outOfScaleRatio(1, 'Major', 'short');
+ok(inS !== null && outS !== null && inS < outS, `ngoài-thang(C major)=${inS && inS.toFixed(3)} < ngoài-thang(C# major)=${outS && outS.toFixed(3)}`);
+console.log(fail ? `❌ ${fail} FAIL` : '✅ TẤT CẢ PASS'); process.exit(fail ? 1 : 0);
diff --git a/tools/algbench/analyze_audio.js b/tools/algbench/analyze_audio.js
new file mode 100644
index 0000000..6680b30
--- /dev/null
+++ b/tools/algbench/analyze_audio.js
@@ -0,0 +1,26 @@
+'use strict';
+// AI-ALG-05 — Phân tích file audio THẬT offline bằng KeyEngine thật (vm + đồng hồ ảo). Cần ffmpeg.
+// Dùng: node tools/algbench/analyze_audio.js <audio> [truthKey vd "A Minor"] [maxSeconds=90]
+// In timeline khoá + kết quả cuối so với đáp án (nếu có). Đáp án phải do người dùng cung cấp; script KHÔNG tự đoán đúng/sai.
+const { spawnSync } = require('child_process'); const path = require('path');
+const REPO = path.resolve(__dirname, '../..');
+const { mkAnalyser, sandbox, loadEngine } = require('./lib.js');
+const [file, truth, maxS] = [process.argv[2], process.argv[3], +(process.argv[4] || 90)];
+if (!file) { console.error('Thiếu file audio'); process.exit(2); }
+const sr = 22050;
+const p = spawnSync('ffmpeg', ['-v', 'error', '-i', file, '-t', String(maxS), '-ac', '1', '-ar', String(sr), '-f', 'f32le', '-'], { maxBuffer: 1 << 29 });
+if (p.status !== 0) { console.error('ffmpeg lỗi:', String(p.stderr).slice(0, 300)); process.exit(3); }
+const pcm = new Float32Array(p.stdout.buffer, p.stdout.byteOffset, Math.floor(p.stdout.length / 4));
+const secs = Math.floor(pcm.length / sr); const clock = { t: 1000 };
+const S = sandbox(clock, () => mkAnalyser(pcm, sr, 8192, clock, 1000), sr); loadEngine(REPO, S.sb, 'keyEngine.js', 'KeyEngine');
+const K = S.sb.KeyEngine; K.init(S.ctx, { connect() {} }); const locks = [];
+K.watchContinuous((r) => locks.push({ t: +((clock.t - 1000) / 1000).toFixed(1), key: r.key }));
+const snaps = [];
+for (let s = 1; s <= secs; s++) { S.step(1000); if (s % 10 === 0) snaps.push({ t: s, est: K.estimateKeyFromChroma().key }); }
+K.stop();
+console.log(`Audio: ${file} (${secs}s) — KHÔNG phải kết quả mặc định đúng; so với đáp án người dùng cung cấp`);
+console.log('Timeline khoá:', locks.map((l) => `${l.t}s:${l.key}`).join(' | ') || '(chưa khoá)');
+console.log('Ước lượng tức thời mỗi 10 s:', snaps.map((x) => `${x.t}s:${x.est}`).join(' | '));
+const fin = locks.length ? locks[locks.length - 1].key : null;
+console.log('Khoá cuối:', fin, '| số lần đổi:', Math.max(0, locks.length - 1), '| thời điểm khoá đầu:', locks[0] ? locks[0].t + 's' : 'n/a');
+if (truth) console.log('Đáp án:', truth, '→', fin === null ? 'CHƯA KHOÁ (ước lượng cuối: ' + snaps[snaps.length - 1].est + ')' : (fin === truth ? 'KHỚP' : 'KHÔNG KHỚP'));
diff --git a/tools/algbench/lib.js b/tools/algbench/lib.js
new file mode 100644
index 0000000..bd07243
--- /dev/null
+++ b/tools/algbench/lib.js
@@ -0,0 +1,29 @@
+'use strict';
+// Thư viện dùng chung cho benchmark offline: FFT + AnalyserNode giả + sandbox vm với đồng hồ ảo (copy từ bench.js, không đổi hành vi).
+const fs=require('fs'),path=require('path'),vm=require('vm');
+function fft(re,im){const n=re.length;for(let i=1,j=0;i<n;i++){let b=n>>1;for(;j&b;b>>=1)j^=b;j^=b;if(i<j){[re[i],re[j]]=[re[j],re[i]];[im[i],im[j]]=[im[j],im[i]];}}
+for(let l=2;l<=n;l<<=1){const a=-2*Math.PI/l,wr=Math.cos(a),wi=Math.sin(a);for(let i=0;i<n;i+=l){let cr=1,ci=0;for(let k=0;k<l/2;k++){const u=i+k,v=i+k+l/2;const tr=re[v]*cr-im[v]*ci,ti=re[v]*ci+im[v]*cr;re[v]=re[u]-tr;im[v]=im[u]-ti;re[u]+=tr;im[u]+=ti;const t=cr*wr-ci*wi;ci=cr*wi+ci*wr;cr=t;}}}}
+function mkAnalyser(pcm,sr,fftSize,clock,t0){
+  const win=new Float32Array(fftSize);for(let i=0;i<fftSize;i++)win[i]=0.42-0.5*Math.cos(2*Math.PI*i/fftSize)+0.08*Math.cos(4*Math.PI*i/fftSize);
+  const re=new Float64Array(fftSize),im=new Float64Array(fftSize);
+  function frame(){const end=Math.floor((clock.t-t0)/1000*sr);const st=Math.max(0,end-fftSize);for(let i=0;i<fftSize;i++){const k=st+i;re[i]=(k<pcm.length?pcm[k]:0)*win[i];im[i]=0;}fft(re,im);}
+  return {fftSize,frequencyBinCount:fftSize/2,smoothingTimeConstant:0,_prevMag:null,
+    getFloatFrequencyData(a){frame();for(let i=0;i<fftSize/2;i++){const m=Math.hypot(re[i],im[i])/fftSize;a[i]=m>0?20*Math.log10(m):-Infinity;}},
+    getByteFrequencyData(a){frame();const N=fftSize/2;if(!this._prevMag)this._prevMag=new Float64Array(N);for(let i=0;i<N;i++){const m=Math.hypot(re[i],im[i])/fftSize;this._prevMag[i]=0.8*this._prevMag[i]+0.2*m;const db=this._prevMag[i]>0?20*Math.log10(this._prevMag[i]):-100;a[i]=Math.max(0,Math.min(255,Math.floor(255*(db+100)/70)));}},
+    getByteTimeDomainData(a){const end=Math.floor((clock.t-t0)/1000*sr);for(let i=0;i<a.length;i++){const k=end-a.length+i;a[i]=Math.max(0,Math.min(255,Math.round(128+128*(k>=0&&k<pcm.length?pcm[k]:0))));}}};
+}
+function sandbox(clock,analyserFactory,sr){
+  const raf=[],ints=[];let iid=0;
+  const sb={console:{log(){},warn(){},error(){}},Math,Array,Float32Array,Uint8Array,Object,Number,JSON,Date:{now:()=>clock.t},
+   requestAnimationFrame:cb=>{raf.push(cb);return raf.length},cancelAnimationFrame:()=>{},
+   setInterval:(fn,ms)=>{ints.push({id:++iid,fn,ms,next:clock.t+ms});return iid},clearInterval:id=>{const i=ints.findIndex(x=>x.id===id);if(i>=0)ints.splice(i,1)},
+   setTimeout:(fn,ms)=>{ints.push({id:++iid,fn,ms,next:clock.t+ms,once:1});return iid},clearTimeout:()=>{},performance:{now:()=>clock.t}};
+  sb.window=sb;vm.createContext(sb);
+  const ctx={sampleRate:sr,createAnalyser:()=>analyserFactory()};
+  return {sb,ctx,raf,ints,step(ms,frameMs=1000/60){const end=clock.t+ms;let acc=0;while(clock.t<end){clock.t+=1;acc+=1;if(acc>=frameMs){acc-=frameMs;raf.splice(0).forEach(cb=>cb());}
+     for(const it of ints.slice()){if(it.next<=clock.t&&ints.includes(it)){if(it.once)ints.splice(ints.indexOf(it),1);else it.next+=it.ms;it.fn();}}}}};
+}
+
+
+const loadEngine=(REPO,sb,f,name)=>vm.runInContext(fs.readFileSync(path.join(REPO,'ui/js/engines',f),'utf8')+`\nthis.${name}=${name};`,sb);
+module.exports={fft,mkAnalyser,sandbox,loadEngine};
diff --git a/tools/algbench/modbench.js b/tools/algbench/modbench.js
new file mode 100644
index 0000000..9ab5c27
--- /dev/null
+++ b/tools/algbench/modbench.js
@@ -0,0 +1,38 @@
+'use strict';
+// AI-ALG-05 — benchmark KeyEngine + ModEngine THẬT trên nhạc pop tổng hợp: (a) giữ nguyên Key => số báo chuyển điệu GIẢ; (b) chuyển điệu thật => độ trễ phát hiện.
+// node tools/algbench/modbench.js <REPO> <out.json> [shard] [nshards]
+const fs = require('fs'), path = require('path');
+const REPO = path.resolve(process.argv[2]); const OUT = process.argv[3]; const shard = +(process.argv[4] || 0), nsh = +(process.argv[5] || 1);
+const { render, PROGS } = require(path.join(REPO, 'tests/helpers/synthPop.js')); const { mkAnalyser, sandbox, loadEngine } = require('./lib.js');
+const NOTE = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
+function song(spec, secs, modAt, shift) {
+    const sr = 22050;
+    const a = render(Object.assign({ sr, seconds: secs + 1 }, spec));
+    if (!modAt) return { pcm: a.pcm, sr };
+    const b = render(Object.assign({ sr, seconds: secs + 1 }, spec, { root: (spec.root + shift + 12) % 12 }));
+    const pcm = new Float32Array(a.pcm.length); const cut = Math.floor(modAt * sr), xf = Math.floor(0.2 * sr);
+    for (let i = 0; i < pcm.length; i++) { if (i < cut - xf) pcm[i] = a.pcm[i]; else if (i >= cut) pcm[i] = b.pcm[i]; else { const w = (i - (cut - xf)) / xf; pcm[i] = a.pcm[i] * (1 - w) + b.pcm[i] * w; } }
+    return { pcm, sr };
+}
+function run(spec, secs, modAt, shift) {
+    const { pcm, sr } = song(spec, secs, modAt, shift); const clock = { t: 1000 };
+    const S = sandbox(clock, () => mkAnalyser(pcm, sr, 8192, clock, 1000), sr); loadEngine(REPO, S.sb, 'keyEngine.js', 'KeyEngine'); loadEngine(REPO, S.sb, 'modEngine.js', 'ModEngine');
+    const K = S.sb.KeyEngine; K.init(S.ctx, { connect() {} });
+    const startRoot = spec.root, mode = spec.mode === 'minor' ? 'Minor' : 'Major';
+    const events = [];
+    // ModEngine bắt đầu sau khi Key gốc "đã chốt" (giả lập renderer: ~12 s đầu)
+    S.step(12000);
+    S.sb.ModEngine.start(startRoot, (d) => events.push({ t: (clock.t - 1000) / 1000, kind: d.kind || 'MODULATION', semitone: d.semitone, target: d.targetKey }), () => false,
+        (st, p) => { if (st === 'KEY_LABEL_CHANGED') events.push({ t: (clock.t - 1000) / 1000, kind: p.kind, label: true }); }, { originalMode: mode });
+    S.step((secs - 12) * 1000); S.sb.ModEngine.stop(); K.stop();
+    return events;
+}
+const cases = [];
+for (const mode of ['major', 'minor']) for (const prog of Object.keys(PROGS[mode])) for (const root of [0, 6]) cases.push({ mode, prog, root, seed: root * 13 + prog.length + 5 });
+const rows = [];
+cases.forEach((c, idx) => { if (idx % nsh !== shard) return;
+    const stat = run(c, 40, 0, 0);
+    const mod = run(c, 40, 24, 2);          // đổi giọng +2 bán cung lúc 24 s
+    rows.push({ mode: c.mode, prog: c.prog, root: c.root, staticEvents: stat, modEvents: mod });
+});
+fs.writeFileSync(OUT, JSON.stringify(rows)); console.log('done', rows.length);
