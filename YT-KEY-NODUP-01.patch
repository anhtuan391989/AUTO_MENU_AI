     const sv = data.segment || {};
     const hienKey = sv.key ? `${sv.key} ${sv.mode === "minor" ? "Phụ" : "Trưởng"}` : `${khoa} ${cheDo === "major" ? "Trưởng" : "Phụ"}`;
     hienThongBao(`✅ Đã lưu${data.baiDaBiet ? " (bài đã biết — cập nhật)" : ""}!\n${start} → ${end} giây\nKhóa: ${hienKey}`, false);
