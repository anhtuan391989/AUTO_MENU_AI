--- /dev/null
+++ b/extensions/HT_YTB_Extension/HUONG_DAN_CAI.txt
@@ -0,0 +1,16 @@
+TIEN ICH YOUTUBE CHO AUTO MENU AI  (ban 1.4.0)
+
+Tien ich gui ve AUTO MENU AI (ngay tren may ban, khong ra Internet): bai YouTube dang phat, dang chay hay tam dung,
+vi tri that (tua la thay ngay), thoi luong, va co dang chieu quang cao khong.
+
+CAI DAT (1 lan, Coc Coc / Chrome):
+1. Mo trinh duyet, vao dia chi:  chrome://extensions   (Coc Coc: coccoc://extensions)
+2. Bat "Che do danh cho nha phat trien" (Developer mode) o goc tren ben phai.
+3. Bam "Tai tien ich da giai nen" (Load unpacked) -> chon thu muc  extensions\HT_YTB_Extension  trong thu muc AUTO_MENU_AI.
+4. Neu truoc do da cai ban cu "HT DAW - YouTube Tone Detection": GO ban cu di (hoac bam nut nap lai), chi giu 1 ban.
+5. Mo lai AUTO MENU AI, mo 1 bai YouTube, bam phat.
+
+LUU Y:
+- Menu chi nhan du lieu tu cong 8765 tren chinh may nay. Neu app HT DAW dang chay cung luc va chiem cong 8765 thi Menu
+  van chay binh thuong bang cach cu (SMTC); dong HT DAW la Menu tu nhan lai trong ~15 giay.
+- Ban tien ich cu (1.3.1) khong gui "thoi luong" nen Menu tam bo qua no. Phai dung ban 1.4.0 nay.
diff --git a/extensions/HT_YTB_Extension/content.js b/extensions/HT_YTB_Extension/content.js
new file mode 100644
index 0000000..8439373
--- /dev/null
+++ b/extensions/HT_YTB_Extension/content.js
@@ -0,0 +1,90 @@
+(() => {
+  'use strict';
+  let lastSignature = '';
+  let lastVideo = null;
+  let lastUrl = location.href;
+
+  function videoIdFromUrl() {
+    try {
+      const u = new URL(location.href);
+      if (u.hostname === 'youtu.be') return u.pathname.split('/').filter(Boolean)[0] || '';
+      if (u.pathname === '/watch') return u.searchParams.get('v') || '';
+      const p = u.pathname.split('/').filter(Boolean);
+      return p.length > 1 && ['shorts', 'live', 'embed', 'v'].includes(p[0]) ? p[1] : '';
+    } catch (_) { return ''; }
+  }
+
+  function getPlayingVideoTitle(id) {
+    // Prefer the title attached to the currently playing video. document.title can
+    // describe a playlist/container instead of the selected item in some YouTube views.
+    try {
+      const playerTitle = window.ytInitialPlayerResponse
+        && window.ytInitialPlayerResponse.videoDetails
+        && window.ytInitialPlayerResponse.videoDetails.title;
+      if (typeof playerTitle === 'string' && playerTitle.trim()) return playerTitle.trim();
+    } catch (_) {}
+    const selectors = [
+      'h1.ytd-watch-metadata yt-formatted-string',
+      'ytd-watch-metadata h1 yt-formatted-string',
+      'meta[itemprop="name"]',
+      'meta[name="title"]'
+    ];
+    for (const selector of selectors) {
+      const node = document.querySelector(selector);
+      const value = node && (node.content || node.textContent || '');
+      if (value && value.trim()) return value.trim();
+    }
+    return (document.title || '').replace(/\s*-\s*YouTube\s*$/i, '').trim() || id;
+  }
+
+  function sendState(force = false) {
+    const id = videoIdFromUrl();
+    if (!/^[A-Za-z0-9_-]{11}$/.test(id)) return;
+    const title = getPlayingVideoTitle(id);
+    const video = document.querySelector('video.html5-main-video, video');
+    const isPlaying = !!(video && !video.paused && !video.ended && video.readyState >= 2);
+    // Đang chiếu quảng cáo thì currentTime là của quảng cáo, không gửi để khỏi lệch mốc đổi tone.
+    const adShowing = !!document.querySelector('.html5-video-player.ad-showing');
+    const currentTime = (video && !adShowing && isFinite(video.currentTime)) ? video.currentTime : null;
+    // Thời lượng video (giây) để AUTO MENU AI hiện đồng hồ "00:43 / 05:05" và so đúng bản thu. Quảng cáo / phát trực tiếp (Infinity) => null.
+    const duration = (video && !adShowing && isFinite(video.duration) && video.duration > 0) ? video.duration : null;
+    const info = { video_id: id, url: `https://www.youtube.com/watch?v=${id}`, title, title_source: 'video', is_playing: isPlaying, current_time: currentTime, duration, is_ad: adShowing };
+    const timeBucket = currentTime === null ? 'ad-or-unknown' : Math.floor(currentTime);
+    const signature = `${id}|${title}|${isPlaying}|${adShowing}|${timeBucket}|${video ? video.readyState : 0}|${duration === null ? 'x' : Math.floor(duration)}`;
+    if (!force && signature === lastSignature) return;
+    lastSignature = signature;
+    try { chrome.runtime.sendMessage({ type: 'ht-youtube-state', info }); } catch (_) {}
+  }
+
+  function bindVideo(video) {
+    if (!video || video === lastVideo) return;
+    lastVideo = video;
+    ['play', 'playing', 'pause', 'ended', 'seeked', 'loadeddata', 'canplay', 'emptied'].forEach(evt =>
+      video.addEventListener(evt, () => sendState(true), { passive: true })
+    );
+  }
+
+  // The service worker requests a fresh player snapshot when a tab becomes active.
+  // Only this content script can authoritatively read video.paused/currentTime.
+  chrome.runtime.onMessage.addListener((message) => {
+    if (message && message.type === 'ht-request-youtube-state') {
+      lastSignature = '';
+      sendState(true);
+    }
+  });
+
+  // Detect YouTube SPA navigation and player state without waiting for the tab title event.
+  setInterval(() => {
+    if (location.href !== lastUrl) {
+      lastUrl = location.href;
+      lastSignature = '';
+      lastVideo = null;
+    }
+    bindVideo(document.querySelector('video.html5-main-video, video'));
+    sendState(false);
+  }, 1000);
+  // Gửi playhead mỗi 1 giây; sự kiện play/pause/seek vẫn được gửi ngay lập tức.
+  document.addEventListener('yt-navigate-finish', () => { lastSignature = ''; sendState(true); }, true);
+  window.addEventListener('popstate', () => { lastSignature = ''; sendState(true); }, true);
+  sendState(true);
+})();
diff --git a/extensions/HT_YTB_Extension/manifest.json b/extensions/HT_YTB_Extension/manifest.json
new file mode 100644
index 0000000..c731b12
--- /dev/null
+++ b/extensions/HT_YTB_Extension/manifest.json
@@ -0,0 +1,32 @@
+{
+  "manifest_version": 3,
+  "name": "HT DAW - YouTube Tone Detection",
+  "version": "1.4.0",
+  "description": "Nhận Video ID, tiêu đề, trạng thái phát và thời gian YouTube để HT DAW phân tích Tone toàn bài.",
+  "permissions": [
+    "tabs",
+    "alarms"
+  ],
+  "host_permissions": [
+    "*://youtube.com/*",
+    "*://*.youtube.com/*",
+    "*://youtu.be/*",
+    "http://127.0.0.1:8765/*"
+  ],
+  "background": {
+    "service_worker": "service_worker.js"
+  },
+  "content_scripts": [
+    {
+      "matches": [
+        "*://youtube.com/*",
+        "*://*.youtube.com/*",
+        "*://youtu.be/*"
+      ],
+      "js": [
+        "content.js"
+      ],
+      "run_at": "document_start"
+    }
+  ]
+}
diff --git a/extensions/HT_YTB_Extension/service_worker.js b/extensions/HT_YTB_Extension/service_worker.js
new file mode 100644
index 0000000..724ab59
--- /dev/null
+++ b/extensions/HT_YTB_Extension/service_worker.js
@@ -0,0 +1,51 @@
+const APP_ENDPOINT = 'http://127.0.0.1:8765/youtube';
+
+async function postInfo(info) {
+  if (!info || !/^[A-Za-z0-9_-]{11}$/.test(info.video_id || '')) return;
+  try {
+    await fetch(APP_ENDPOINT, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(info),
+      cache: 'no-store'
+    });
+  } catch (_) { /* The desktop app may not be running yet. */ }
+}
+
+// Never synthesize playback state from chrome.tabs: tab metadata cannot tell
+// whether the actual YouTube video is playing or provide its playhead.
+async function requestPlayerState(tabId) {
+  if (!Number.isInteger(tabId)) return;
+  try {
+    await chrome.tabs.sendMessage(tabId, { type: 'ht-request-youtube-state' });
+  } catch (_) {
+    // Content script may not be injected yet. It will publish on its next poll.
+  }
+}
+
+async function inspectActiveTab() {
+  try {
+    const tabs = await chrome.tabs.query({ active: true, lastFocusedWindow: true });
+    if (tabs && tabs.length && Number.isInteger(tabs[0].id))
+      await requestPlayerState(tabs[0].id);
+  } catch (_) {}
+}
+
+chrome.runtime.onMessage.addListener((message, sender) => {
+  if (!message || message.type !== 'ht-youtube-state' || !sender.tab) return;
+  postInfo(message.info || {});
+});
+
+chrome.tabs.onUpdated.addListener((tabId, changeInfo, tab) => {
+  if (changeInfo.url || changeInfo.status === 'complete') {
+    chrome.tabs.query({ active: true, lastFocusedWindow: true }).then(tabs => {
+      const active = tabs && tabs[0];
+      if (active && active.id === tabId) requestPlayerState(tabId);
+    }).catch(() => {});
+  }
+});
+chrome.tabs.onActivated.addListener(activeInfo => requestPlayerState(activeInfo.tabId));
+chrome.windows.onFocusChanged.addListener(() => inspectActiveTab());
+chrome.alarms.create('ht-audio-youtube-watch', { periodInMinutes: 0.5 });
