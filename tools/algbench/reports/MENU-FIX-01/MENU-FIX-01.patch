+// KHÔNG áp dụng cho FX (không có Find Track). Bấm mới cùng nút trong lúc chờ => huỷ lệnh gửi lại cũ. Setting "dawStateResendMs": 0 = tắt.
+const DAW_STATE_RESEND_CONTROLS = new Set(["MIC1", "MIC2", "MUSIC"]);
+const DAW_STATE_RESEND_DEFAULT_MS = 350;
+function getDawStateResendMs() {
+    const v = typeof getSetting === "function" ? getSetting("dawStateResendMs") : undefined;
+    if (v === undefined || v === null || v === "") return DAW_STATE_RESEND_DEFAULT_MS;
+    const n = Number(v);
+    if (!Number.isFinite(n) || n <= 0) return 0;
+    return Math.min(n, 2000);
+}
+function cancelDawStateResend(control) {
+    if (typeof window === "undefined" || !window.__dawResendTimers) return;
+    const t = window.__dawResendTimers[control];
+    if (t) { clearTimeout(t); window.__dawResendTimers[control] = null; }
+}
+function scheduleDawStateResend(control, action, reason) {
+    const ms = getDawStateResendMs();
+    if (!ms || typeof window === "undefined") return false;
+    window.__dawResendTimers = window.__dawResendTimers || {};
+    cancelDawStateResend(control);
+    window.__dawResendTimers[control] = setTimeout(() => {
+        window.__dawResendTimers[control] = null;
+        executeAction(action, { reason: `${reason}-resend` })
+            .then((r) => {
+                const last = window.__dawStateLast && window.__dawStateLast[control];
+                if (last) last.resend = { ok: !!(r && r.ok), at: Date.now() };
+            })
+            .catch((err) => console.error(`[DawState] ${control} gửi lại ${action} lỗi:`, err));
+    }, ms);
+    return true;
+}
