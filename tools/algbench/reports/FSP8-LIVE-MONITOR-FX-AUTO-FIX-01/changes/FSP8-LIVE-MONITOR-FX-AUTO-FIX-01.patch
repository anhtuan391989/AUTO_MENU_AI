+        ok(r.btn.dataset.fxSync === 'sent-unconfirmed' && /FX/.test(r.btn.title) && /chưa xác nhận/.test(r.btn.title) && !/Send Reverb/.test(r.btn.title), 'tooltip: đã GỬI lệnh FX, "chưa xác nhận", KHÔNG nói Send Reverb/Delay', r.btn.title);
