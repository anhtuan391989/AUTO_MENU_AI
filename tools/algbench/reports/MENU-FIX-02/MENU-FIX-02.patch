+        await r.run(62, MUS);
+        ok(r.sent.filter((s) => s.n === 108).length >= 2, 'bấm tay BẬT bị lỗi (không đánh dấu đã gửi) -> sau 60 s Auto gửi lại FX_ON khi có nhạc', r.sent);
