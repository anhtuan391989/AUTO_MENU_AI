+/**
+ * AI-RUNTIME-VERIFY-02 — kiểm tra lệnh `capture` (tự lấy Key/LOCK/tín hiệu từ log).
+ * Log MÔ PHỎNG trong thư mục tạm; KHÔNG phải kết quả nhạc thật, không đụng results.csv thật.
+ * Chạy: node tests/unit/RuntimeVerifyCapture.verify.js
+ */
+const assert = require("assert");
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+const cp = require("child_process");
+const RV = path.resolve(__dirname, "../calibration/runtime-verify");
+const S = require(path.join(RV, "score_runtime_verify.js"));
+const R = require(path.join(RV, "record_result.js"));
+
+let fail = 0;
+function check(c, m) { try { assert.ok(c, m); console.log("  OK   " + m); } catch (e) { fail++; console.log("  FAIL " + m); } }
+const throws = (f) => { try { f(); return false; } catch (e) { return true; } };
+
+const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "rv3-"));
+const logs = path.join(tmp, "logs"); fs.mkdirSync(logs);
+const ids = S.parseCsv(fs.readFileSync(path.join(RV, "ground_truth.csv"), "utf-8")).map((r) => r.id);
+const rec = (time, conf) => JSON.stringify({ time, top1: "C Major", confidence: conf, votes: 0, locked: false });
+const lock = (time, key) => JSON.stringify({ event: "LOCK", time, key });
+const write = (name, lines) => { const p = path.join(logs, name); fs.writeFileSync(p, lines.join("\n") + "\n"); return p; };
+
+// log cũ + log mới (sắp theo tên). Log mới: phiên1 khoá A Major@4.4; phiên2 (re-lock cùng bài) khoá A Major@2; phiên3 toàn conf=0
+write("2026-10-29_10-00-00.jsonl", [rec(1.5, 0.9), lock(3, "G Major")]);
+const newest = write("2026-10-29_11-00-00.jsonl", [rec(1.5, 0.9), lock(4.4, "A Major"), rec(1.5, 0.9), lock(2, "A Major"), rec(1.5, 0), rec(3, 0), rec(4.5, 0)]);
+write("9999-01-01_00-00-01_TEST.jsonl", [rec(1.5, 0.9), lock(3, "F Minor")]);
+
+console.log("== chọn log & phiên ==");
+check(R.latestLog(logs) === newest, "latestLog chọn file MỚI NHẤT, bỏ qua file *_TEST / 9999-");
+check(throws(() => R.latestLog(path.join(tmp, "khong-co"))), "thiếu thư mục log => báo lỗi rõ");
+const emptyDir = path.join(tmp, "empty"); fs.mkdirSync(emptyDir);
+check(throws(() => R.latestLog(emptyDir)), "thư mục log rỗng => báo lỗi rõ");
+const pk = R.pickFromLog(newest);
+check(pk.total === 3 && pk.sess.index === 2 && !pk.fallbackNoLock, "bỏ phiên cuối không LOCK, lấy phiên 2 (phiên cuối CÓ LOCK)");
+
+console.log("== capture ghi đúng, chỉ dùng dữ liệu log ==");
+const f1 = path.join(tmp, "r1.csv");
+const r1 = R.captureRow(f1, ids, "S01", { bpm: "169" }, logs);
+const row1 = S.parseCsv(fs.readFileSync(f1, "utf-8")).find((r) => r.id === "S01");
+check(row1.shown_key === "A Major" && row1.shown_bpm === "169" && row1.t_lock_s === "2" && row1.level_ok === "yes", "S01: Key/LOCK/tín hiệu lấy từ log, BPM do người dùng nhập");
+check(/\[auto-log 2026-10-29_11-00-00\.jsonl phiên 2\/3\]/.test(row1.notes), "notes ghi rõ nguồn log + số phiên (truy vết được)");
+check(row1.session === "", "không ghi cột session (tránh chấm nhầm khi đổi file log)");
+check(S.classifyKey(row1.shown_key, "A major", []) === "EXACT", "bộ chấm đọc được Key 'A Major' từ log và chấm EXACT");
+
+console.log("== người dùng gõ tay thắng log ==");
+R.captureRow(f1, ids, "S02", { bpm: "67", key: "F# minor", lock: "9.5", notes: "bản live" }, logs);
+const row2 = S.parseCsv(fs.readFileSync(f1, "utf-8")).find((r) => r.id === "S02");
+check(row2.shown_key === "F# minor" && row2.t_lock_s === "9.5" && /bản live/.test(row2.notes), "--key/--lock/--notes do người dùng nhập được ưu tiên");
+
+console.log("== không có BPM => để trống, không bịa ==");
+R.captureRow(f1, ids, "S03", {}, logs);
+const row3 = S.parseCsv(fs.readFileSync(f1, "utf-8")).find((r) => r.id === "S03");
+check(row3.shown_bpm === "" && row3.shown_key === "A Major", "BPM trống khi không nhập (log không có BPM)");
+
+console.log("== log không có LOCK nào ==");
+const quiet = write("2026-10-29_12-00-00.jsonl", [rec(1.5, 0), rec(3, 0), rec(4.5, 0), rec(6, 0)]);
+const f2 = path.join(tmp, "r2.csv");
+const rq = R.captureRow(f2, ids, "S04", { log: quiet, bpm: "105" }, logs);
+const rowq = S.parseCsv(fs.readFileSync(f2, "utf-8")).find((r) => r.id === "S04");
+check(rq.fallbackNoLock && rowq.shown_key === "" && rowq.level_ok === "no" && /KHÔNG có LOCK/.test(rowq.notes), "không LOCK + conf=0: KHÔNG điền Key, level=no, ghi chú cảnh báo");
+const mid = write("2026-10-29_13-00-00.jsonl", [rec(1.5, 0.8), rec(3, 0.8), rec(4.5, 0.8)]);
+R.captureRow(f2, ids, "S05", { log: mid }, logs);
+const rowm = S.parseCsv(fs.readFileSync(f2, "utf-8")).find((r) => r.id === "S05");
+check(rowm.shown_key === "" && rowm.level_ok === "", "không LOCK nhưng conf>0: không điền Key, không đoán tín hiệu (để trống)");
+
+console.log("== an toàn dữ liệu ==");
+const before = fs.readFileSync(f1, "utf-8");
+check(throws(() => R.captureRow(f1, ids, "S01", { bpm: "1000" }, logs)) && fs.readFileSync(f1, "utf-8") === before, "BPM không hợp lệ bị từ chối, file không đổi");
+check(throws(() => R.captureRow(f1, ids, "S01", { bpm: "170" }, logs)) && fs.readFileSync(f1, "utf-8") === before, "capture lên bài đã có dữ liệu bị CHẶN, file không đổi");
+check(throws(() => R.captureRow(f1, ids, "S99", { bpm: "100" }, logs)), "ID ngoài S01–S13 bị từ chối");
+R.captureRow(f1, ids, "S01", { bpm: "170", force: true }, logs);
+check(fs.readdirSync(tmp).some((n) => n.startsWith("r1.csv.bak-")) && S.parseCsv(fs.readFileSync(f1, "utf-8"))[0].shown_bpm === "170", "--force: ghi đè nhưng có sao lưu .bak trước");
+check(throws(() => R.captureRow(f1, ids, "S06", { log: path.join(tmp, "nope.jsonl"), bpm: "120" }, logs)), "--log trỏ file không tồn tại => báo lỗi");
+
+console.log("== chạy qua dòng lệnh (CLI) ==");
+const f3 = path.join(tmp, "r3.csv");
+const logs2 = path.join(tmp, "logs2"); fs.mkdirSync(logs2); fs.copyFileSync(newest, path.join(logs2, path.basename(newest)));
+const cli = (args) => cp.spawnSync(process.execPath, [path.join(RV, "record_result.js"), ...args, "--file", f3, "--logs", logs2], { encoding: "utf-8" });
+const c1 = cli(["capture", "S07", "--bpm", "118"]);
+check(c1.status === 0 && /Key=A Major/.test(c1.stdout) && /đối chiếu/.test(c1.stdout), "CLI capture S07 thành công, nhắc đối chiếu với Menu");
+const c2 = cli(["capture", "S07", "--bpm", "118"]);
+check(c2.status === 1 && /không ghi đè/.test(c2.stderr), "CLI chặn ghi đè");
+const sc = cp.spawnSync(process.execPath, [path.join(RV, "score_runtime_verify.js"), "--truth", path.join(RV, "ground_truth.csv"), "--results", f3], { encoding: "utf-8" });
+check(sc.status === 0 && /Đã kiểm thử: 1\/13/.test(sc.stdout), "bộ chấm đọc file do capture ghi: 1/13 đã kiểm thử");
+check(fs.readFileSync(path.join(RV, "results.csv"), "utf-8").split("\n").slice(1).filter(Boolean).every((l) => /^S\d\d,+$/.test(l)), "results.csv THẬT vẫn trống (test không đụng vào)");
+
+console.log(`\n== KẾT QUẢ: ${fail === 0 ? "TẤT CẢ PASS" : fail + " FAIL"} ==`);
+process.exit(fail === 0 ? 0 : 1);
