+    add({ id: 'g1.hum60-35', g: 1, desc: 'ù 60 Hz + hài (1..8) -35 dBFS (không phải nhạc)', truth: null, dur: DUR, build: mk((b) => { for (let h = 1; h <= 8; h++) S.addNote(b, 69 + 12 * Math.log2(60 * h / 440), 0, DUR, 1 / h, 'organ'); }, DUR, -35) });
