diff --git a/tests/unit/LicenseMarquee01.verify.js b/tests/unit/LicenseMarquee01.verify.js
new file mode 100644
index 0000000..b39091d
--- /dev/null
+++ b/tests/unit/LicenseMarquee01.verify.js
@@ -0,0 +1,34 @@
+// LICENSE-MARQUEE-01 — chạy đúng khối mã trong ui/js/renderer.js bằng vm với DOM/electronAPI GIẢ. KHÔNG phải Electron thật.
+// Chạy: node tests/unit/LicenseMarquee01.verify.js
+'use strict';
+const fs = require('fs'), path = require('path'), vm = require('vm');
+const src = fs.readFileSync(path.join(__dirname, '..', '..', 'ui', 'js', 'renderer.js'), 'utf8');
+let pass = 0, fail = 0; const ok = (c, m, x) => { if (c) { pass++; console.log('  OK  ', m); } else { fail++; console.log('  FAIL', m, x === undefined ? '' : JSON.stringify(x)); } };
+const a = src.indexOf('/* LICENSE-MARQUEE-01 BEGIN'), b = src.indexOf('/* LICENSE-MARQUEE-01 END */');
+ok(a > 0 && b > a, 'renderer.js có khối LICENSE-MARQUEE-01');
+const block = src.slice(a, b);
+ok(!/innerHTML/.test(block), 'không dùng innerHTML');
+const HARD = '✨ Hỗ trợ kỹ thuật: Khói Studio | Thời hạn Key dịch vụ: Vĩnh viễn (Pro Active) | Liên hệ Zalo: 0349.644.194 ✨';
+function run(status, lang) {
+    const el = { textContent: HARD, attrs: {}, setAttribute(k, v) { this.attrs[k] = v; } };
+    const ctx = { console, setInterval() {}, document: { querySelector: (s) => (s === '.marquee-text' ? el : null) },
+        window: { electronAPI: { licenseStatus: () => Promise.resolve(status) }, I18N: { lang }, addEventListener() {} } };
+    ctx.globalThis = ctx; vm.createContext(ctx); vm.runInContext(block, ctx);
+    return new Promise((r) => setTimeout(() => r(el), 20));
+}
+(async () => {
+    const exp = new Date(2027, 10, 11).getTime();
+    let el = await run({ licensed: true, plan: '1y', planLabel: '1 năm', expiresAt: exp, daysLeft: 365 }, 'vi');
+    ok(el.textContent.includes('1 năm, còn 365 ngày (hết hạn 11/11/2027)'), 'gói 1 năm: hiện đúng thời hạn thật (vi)', el.textContent);
+    ok(!el.textContent.includes('Vĩnh viễn'), 'gói 1 năm: không còn chữ "Vĩnh viễn"');
+    ok(el.textContent.includes('0349.644.194'), 'giữ nguyên số Zalo');
+    el = await run({ licensed: true, plan: '1y', planLabel: '1 năm', expiresAt: exp, daysLeft: 365 }, 'en');
+    ok(el.textContent.includes('1 year, 365 days left (expires 11/11/2027)'), 'gói 1 năm (en)', el.textContent);
+    el = await run({ licensed: true, plan: 'life', planLabel: 'Vĩnh viễn' }, 'vi');
+    ok(el.textContent.includes('Thời hạn Key dịch vụ: Vĩnh viễn |'), 'gói Vĩnh viễn: hiện Vĩnh viễn');
+    el = await run({ licensed: true, plan: 'life' }, 'en');
+    ok(el.textContent.includes('validity: Lifetime |'), 'gói Vĩnh viễn (en)');
+    el = await run({ licensed: false, code: 'EXPIRED' }, 'vi');
+    ok(el.textContent === HARD, 'không có license hợp lệ: không đụng chữ cũ');
+    console.log(`\n${pass} PASS / ${fail} FAIL`); process.exit(fail ? 1 : 0);
+})();
diff --git a/ui/js/renderer.js b/ui/js/renderer.js
index 29b3c81..4b6c745 100644
--- a/ui/js/renderer.js
+++ b/ui/js/renderer.js
@@ -4142,3 +4142,46 @@ function bridgeSemitoneDelta(fromKeyName, toKeyName) {
     } catch (err) { console.error("MENU-LAYOUT-MEMORY-01 lỗi (bỏ qua):", err); }
 })();
 /* MENU-LAYOUT-MEMORY-01 END */
+
+/* LICENSE-MARQUEE-01 BEGIN — dòng chạy "Thời hạn Key dịch vụ" ở đáy Menu đọc thời hạn THẬT từ license (cùng nguồn với mục License trong Cài đặt), thay cho chữ cứng "Vĩnh viễn (Pro Active)" trong HTML. KHÔNG sửa HTML: chỉ đổi chữ của .marquee-text lúc chạy. */
+(function licenseMarqueeInit() {
+    "use strict";
+    function pad2(n) { return (n < 10 ? "0" : "") + n; }
+    function fmtDate(ms) { const d = new Date(ms); return pad2(d.getDate()) + "/" + pad2(d.getMonth() + 1) + "/" + d.getFullYear(); }
+    // Trả về phần chữ thời hạn theo ngôn ngữ đang chọn; null nếu chưa có dữ liệu đáng tin (khi đó giữ nguyên chữ hiện có).
+    function validityText(st, en) {
+        if (!st || st.licensed !== true) return null;
+        if (st.plan === "life") return en ? "Lifetime" : "Vĩnh viễn";
+        if (typeof st.expiresAt !== "number" || typeof st.daysLeft !== "number") return null;
+        const planVi = st.planLabel || "";
+        const planEn = { "3d": "3 days", "3m": "3 months", "6m": "6 months", "1y": "1 year" }[st.plan] || planVi;
+        return en
+            ? planEn + ", " + st.daysLeft + " days left (expires " + fmtDate(st.expiresAt) + ")"
+            : planVi + ", còn " + st.daysLeft + " ngày (hết hạn " + fmtDate(st.expiresAt) + ")";
+    }
+    function buildLine(valid, en) {
+        return en
+            ? "✨ Tech support: Khói Studio | Service Key validity: " + valid + " | Contact Zalo: 0349.644.194 ✨"
+            : "✨ Hỗ trợ kỹ thuật: Khói Studio | Thời hạn Key dịch vụ: " + valid + " | Liên hệ Zalo: 0349.644.194 ✨";
+    }
+    function refresh() {
+        try {
+            const el = document.querySelector(".marquee-text");
+            const api = window.electronAPI;
+            if (!el || !api || typeof api.licenseStatus !== "function") return;
+            Promise.resolve(api.licenseStatus()).then((st) => {
+                const en = !!(window.I18N && window.I18N.lang === "en");
+                const v = validityText(st, en);
+                if (v === null) return;
+                el.setAttribute("data-i18n-skip", ""); // tự dịch theo ngôn ngữ ở đây, không để bộ dịch chuỗi cố định đụng vào
+                const line = buildLine(v, en);
+                if (el.textContent !== line) el.textContent = line;
+            }).catch(() => { /* giữ nguyên chữ hiện có */ });
+        } catch (err) { console.error("LICENSE-MARQUEE-01 lỗi (bỏ qua):", err); }
+    }
+    if (typeof document === "undefined") return;
+    refresh();
+    setInterval(refresh, 10 * 60 * 1000);   // số ngày còn lại đổi theo ngày
+    window.addEventListener("focus", refresh); // quay lại từ Cài đặt (đổi ngôn ngữ / gia hạn) thì cập nhật ngay
+})();
+/* LICENSE-MARQUEE-01 END */
