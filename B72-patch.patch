+'use strict';
+/**
+ * B72SetupCompletion.verify.js — TASK B72
+ * "Hoàn thiện Setup: cấu hình, lưu trữ, khôi phục và tích hợp runtime"
+ * Test HÀNH VI THỰC TẾ (không chỉ regex tên hàm) bằng cách import thẳng các hàm thật của
+ * audioSource.js vào 1 sandbox `vm` với getSetting/setSetting giả lập (giống style
+ * SoundcardSetupPersistence.verify.js đã có), cộng với kiểm tra source cho phần còn lại.
+ *
+ * Coverage — đúng bảng B72-07 (persistence) + phát hiện B72 mới (dot-audio 2 nơi ghi đè nhau):
+ *  1. Thiếu key trong settings file -> dùng giá trị mặc định (merge {...DEFAULT, ...file}).
+ *  2. Có key cũ (selectedSoundcardId) -> không tự chuyển/xoá, key mới vẫn giữ mặc định riêng.
+ *  3. Chọn None -> lưu đúng "" cho cả MIC lẫn SYSTEM_AUDIO (hành vi thật của getMicDeviceId/
+ *     getSystemAudioDeviceId, không chỉ kiểm tra chuỗi code).
+ *  4. [PHÁT HIỆN B72] dot-audio KHÔNG còn 2 hàm ghi đè nhau (updateMainStatus() vs
+ *     checkAllSystems()) — đã gộp về updateAudioInterfaceDot() DUY NHẤT.
+ *  5. updateAudioInterfaceDot() phân biệt "đã lưu nhưng không khả dụng" với "chưa từng chọn".
+ *
+ * Chạy: node tests/unit/B72SetupCompletion.verify.js
+ */
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+let pass = 0, fail = 0;
+function assert(cond, label) {
+    if (cond) { pass++; console.log('  OK  ', label); }
+    else { fail++; console.error('  FAIL ', label); }
+}
+
+const ROOT = path.join(__dirname, '..', '..');
+const appSettingsSrc = fs.readFileSync(path.join(ROOT, 'ui/js/appSettings.js'), 'utf8');
+const audioSourceSrc = fs.readFileSync(path.join(ROOT, 'ui/js/audioSource.js'), 'utf8');
+const rendererSrc = fs.readFileSync(path.join(ROOT, 'ui/js/renderer.js'), 'utf8');
+
+console.log('== Test 1: DEFAULT_APP_SETTINGS có cả selectedMicDeviceId + selectedSystemAudioDeviceId (thiếu key -> dùng mặc định) ==');
+{
+    const sandbox = {};
+    vm.createContext(sandbox);
+    // Chỉ eval phần khai báo DEFAULT_APP_SETTINGS (object literal thuần, không phụ thuộc gì khác).
+    const defMatch = appSettingsSrc.match(/const DEFAULT_APP_SETTINGS = \{[\s\S]*?\n\};/);
+    assert(!!defMatch, 'Tìm thấy khai báo DEFAULT_APP_SETTINGS');
+    if (defMatch) {
+        vm.runInContext(defMatch[0] + '\nthis.DEFAULT_APP_SETTINGS = DEFAULT_APP_SETTINGS;', sandbox);
+        assert(sandbox.DEFAULT_APP_SETTINGS.selectedMicDeviceId === "", 'DEFAULT_APP_SETTINGS.selectedMicDeviceId === ""');
+        assert(sandbox.DEFAULT_APP_SETTINGS.selectedSystemAudioDeviceId === "", 'DEFAULT_APP_SETTINGS.selectedSystemAudioDeviceId === ""');
+
+        // Mô phỏng ĐÚNG dòng merge thật trong loadSetup(): appSettings = {...DEFAULT_APP_SETTINGS, ...fromFile}
+        const fileThieuKey = { selectedDAW: "FL Studio" }; // settings file cũ, KHÔNG có 2 key mới
+        const merged = { ...sandbox.DEFAULT_APP_SETTINGS, ...fileThieuKey };
+        assert(merged.selectedMicDeviceId === "", 'Test 1 [hành vi thật]: file thiếu "selectedMicDeviceId" -> merge ra "" (giá trị mặc định), không phải undefined');
+        assert(merged.selectedSystemAudioDeviceId === "", 'Test 1 [hành vi thật]: file thiếu "selectedSystemAudioDeviceId" -> merge ra "" (giá trị mặc định)');
+        assert(merged.selectedDAW === "FL Studio", 'Test 1 [hành vi thật]: key CÓ trong file vẫn giữ đúng giá trị đã lưu (merge không đè lung tung)');
+    }
+}
+assert(/loadSetup\(\)[\s\S]*?appSettings = \{ \.\.\.DEFAULT_APP_SETTINGS, \.\.\.fromFile \};/.test(appSettingsSrc),
+    'appSettings.js: loadSetup() dùng đúng {...DEFAULT_APP_SETTINGS, ...fromFile} (không tạo cơ chế merge mới nào khác)');
+
+console.log('\n== Test 2: Key cũ (selectedSoundcardId) không tự chuyển sang key mới khi load file cũ ==');
+{
+    const sandbox = {};
+    vm.createContext(sandbox);
+    const defMatch = appSettingsSrc.match(/const DEFAULT_APP_SETTINGS = \{[\s\S]*?\n\};/);
+    vm.runInContext(defMatch[0] + '\nthis.DEFAULT_APP_SETTINGS = DEFAULT_APP_SETTINGS;', sandbox);
+    // Settings file CŨ (trước B71) — chỉ có selectedSoundcardId, không có 2 key mới.
+    const fileCu = { selectedSoundcardId: "mix01-device-abc", selectedSoundcard: "Mix 01" };
