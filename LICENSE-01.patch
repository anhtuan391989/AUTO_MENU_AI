+++ b/MENU-LICENSE-SERVER/worker.js
@@ -0,0 +1,241 @@
+// LICENSE-01 — Server License cho MENU (Cloudflare Worker + D1). ĐỘC LẬP với server Key bài hát.
+// Quy tắc: 1 key = 1 mã máy. Thời hạn tính từ lúc kích hoạt. Server là nguồn giờ duy nhất.
+// Mọi phản hồi "được dùng" đều được ký Ed25519 (khoá riêng nằm ở Secret LICENSE_SIGN_KEY, app chỉ giữ khoá công khai).
+
+const PLANS = { "3d": { days: 3 }, "3m": { months: 3 }, "6m": { months: 6 }, "1y": { months: 12 } };
+const ALPHABET = "ABCDEFGHJKMNPQRSTVWXYZ23456789"; // 30 ký tự, bỏ I L O U 0 1 cho dễ đọc
+const DAY_MS = 86400000;
+
+const CORS = {
+    "Access-Control-Allow-Origin": "*",
+    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
+    "Access-Control-Allow-Headers": "Content-Type, Authorization"
+};
+
+function json(obj, status) {
+    return new Response(JSON.stringify(obj), { status: status || 200, headers: Object.assign({ "Content-Type": "application/json; charset=utf-8" }, CORS) });
+}
+function fail(reason, message, status) { return json({ ok: false, reason, message }, status || 200); }
+
+// ---------- tiện ích ----------
+function randomKey() {
+    const out = [];
+    while (out.length < 20) {
+        const buf = new Uint8Array(32);
+        crypto.getRandomValues(buf);
+        for (const b of buf) { if (b < 240 && out.length < 20) out.push(ALPHABET[b % 30]); } // 240 = 30*8, tránh lệch xác suất
+    }
+    return "MENU-" + out.join("").match(/.{5}/g).join("-");
+}
+function normalizeKey(raw) {
+    const s = String(raw || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
+    const m = /^MENU([A-Z0-9]{20})$/.exec(s);
+    if (!m) return null;
+    for (const ch of m[1]) if (ALPHABET.indexOf(ch) < 0) return null;
+    return "MENU-" + m[1].match(/.{5}/g).join("-");
+}
+function normalizeMachine(raw) {
+    const s = String(raw || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
+    return /^[A-Z0-9]{16,40}$/.test(s) ? s : null;
+}
+async function sha256Hex(text) {
+    const d = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
+    return Array.from(new Uint8Array(d)).map((b) => b.toString(16).padStart(2, "0")).join("");
+}
+function addPlan(ts, plan) {
+    const p = PLANS[plan];
+    if (!p) return null;
+    if (p.days) return ts + p.days * DAY_MS;
+    const d = new Date(ts);
+    const day = d.getUTCDate();
+    d.setUTCDate(1);
+    d.setUTCMonth(d.getUTCMonth() + p.months);
+    const last = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 0)).getUTCDate();
+    d.setUTCDate(Math.min(day, last));
+    return d.getTime();
+}
+function safeEqual(a, b) {
+    a = String(a); b = String(b);
+    let diff = a.length ^ b.length;
+    const n = Math.max(a.length, b.length);
+    for (let i = 0; i < n; i++) diff |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
+    return diff === 0;
+}
+function b64ToBytes(b64) {
+    const bin = atob(String(b64).replace(/\s+/g, ""));
+    const u = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i);
+    return u;
+}
+function bytesToB64(bytes) {
+    let s = "";
+    for (const b of new Uint8Array(bytes)) s += String.fromCharCode(b);
+    return btoa(s);
+}
+
+// ---------- ký phản hồi ----------
+let signKeyCache = null; // { raw, key }
+async function getSignKey(env) {
+    if (!env.LICENSE_SIGN_KEY) throw new Error("missing LICENSE_SIGN_KEY");
+    if (signKeyCache && signKeyCache.raw === env.LICENSE_SIGN_KEY) return signKeyCache.key;
+    const der = b64ToBytes(env.LICENSE_SIGN_KEY);
+    let key;
+    try { key = await crypto.subtle.importKey("pkcs8", der, { name: "Ed25519" }, false, ["sign"]); }
+    catch (_) { key = await crypto.subtle.importKey("pkcs8", der, { name: "NODE-ED25519", namedCurve: "NODE-ED25519" }, false, ["sign"]); }
+    signKeyCache = { raw: env.LICENSE_SIGN_KEY, key };
+    return key;
+}
+async function signPayload(env, payloadObj) {
+    const payload = JSON.stringify(payloadObj);
+    const key = await getSignKey(env);
+    let sig;
+    try { sig = await crypto.subtle.sign({ name: "Ed25519" }, key, new TextEncoder().encode(payload)); }
+    catch (_) { sig = await crypto.subtle.sign({ name: "NODE-ED25519" }, key, new TextEncoder().encode(payload)); }
+    return { payload, sig: bytesToB64(sig) };
+}
+
+// ---------- logic license ----------
+const MESSAGES = {
+    INVALID_KEY: "Key không đúng. Kiểm tra lại từng ký tự.",
+    REVOKED: "Key đã bị thu hồi. Liên hệ người cung cấp.",
+    EXPIRED: "Key đã hết hạn. Hãy mua/nhập key mới.",
+    MACHINE_MISMATCH: "Key này đã gắn với máy khác (1 key chỉ dùng cho 1 máy).",
+    NOT_ACTIVATED: "Key chưa được kích hoạt trên máy này."
+};
+function evaluate(row, machine, now) {
+    if (!row) return "INVALID_KEY";
+    if (row.status === "revoked") return "REVOKED";
+    if (row.machine && row.machine !== machine) return "MACHINE_MISMATCH";
+    if (row.status === "active" && row.expires_at != null && row.expires_at <= now) return "EXPIRED";
+    return null;
+}
+async function okResponse(env, row, now) {
+    const signed = await signPayload(env, {
+        v: 1, status: "active", machine: row.machine, plan: row.plan,
+        activatedAt: row.activated_at, expiresAt: row.expires_at, issuedAt: now
+    });
+    return json({ ok: true, payload: signed.payload, sig: signed.sig, serverTime: now });
+}
+async function findRow(env, key) {
+    const hash = await sha256Hex(key);
+    return await env.DB.prepare("SELECT * FROM licenses WHERE key_hash = ?").bind(hash).first();
+}
+async function readBody(request) {
+    try { const b = await request.json(); return (b && typeof b === "object") ? b : {}; } catch (_) { return {}; }
+}
+
+async function handleActivate(request, env) {
+    const body = await readBody(request);
+    const key = normalizeKey(body.key);
+    const machine = normalizeMachine(body.machine);
+    if (!key) return fail("INVALID_KEY", MESSAGES.INVALID_KEY);
+    if (!machine) return fail("BAD_REQUEST", "Mã máy không hợp lệ.");
+    const now = Date.now();
+    let row = await findRow(env, key);
+    let reason = evaluate(row, machine, now);
+    if (reason) return fail(reason, MESSAGES[reason]);
+
+    if (row.status === "unused") {
+        const exp = addPlan(now, row.plan);
+        const r = await env.DB.prepare("UPDATE licenses SET status='active', machine=?, activated_at=?, expires_at=? WHERE id=? AND status='unused'")
+            .bind(machine, now, exp, row.id).run();
+        if (!r || !r.meta || r.meta.changes !== 1) { // máy khác vừa kích hoạt trước
+            row = await findRow(env, key);
+            reason = evaluate(row, machine, now);
+            if (reason) return fail(reason, MESSAGES[reason]);
+        } else {
+            row = await findRow(env, key);
+        }
+    } else if (row.status === "active" && !row.machine) { // đã được gỡ máy cũ -> gắn máy mới, giữ nguyên hạn
+        await env.DB.prepare("UPDATE licenses SET machine=? WHERE id=? AND machine IS NULL").bind(machine, row.id).run();
+        row = await findRow(env, key);
+        reason = evaluate(row, machine, now);
+        if (reason) return fail(reason, MESSAGES[reason]);
+    }
+    return await okResponse(env, row, now);
+}
+
+async function handleCheck(request, env) {
+    const body = await readBody(request);
+    const key = normalizeKey(body.key);
+    const machine = normalizeMachine(body.machine);
+    if (!key) return fail("INVALID_KEY", MESSAGES.INVALID_KEY);
+    if (!machine) return fail("BAD_REQUEST", "Mã máy không hợp lệ.");
+    const now = Date.now();
+    const row = await findRow(env, key);
+    let reason = evaluate(row, machine, now);
+    if (!reason && (row.status !== "active" || row.machine !== machine)) reason = "NOT_ACTIVATED";
+    if (reason) return fail(reason, MESSAGES[reason]);
+    return await okResponse(env, row, now);
+}
+
+// ---------- quản trị (cần ADMIN_TOKEN) ----------
+function isAdmin(request, env) {
+    if (!env.ADMIN_TOKEN) return false;
+    const auth = request.headers.get("Authorization") || "";
+    return safeEqual(auth, "Bearer " + env.ADMIN_TOKEN);
+}
+function publicRow(r) {
+    return { id: r.id, hint: r.key_hint, plan: r.plan, note: r.note, status: r.status, machine: r.machine,
+        createdAt: r.created_at, activatedAt: r.activated_at, expiresAt: r.expires_at };
+}
+async function handleAdmin(path, request, env) {
+    if (!env.ADMIN_TOKEN) return fail("ADMIN_NOT_CONFIGURED", "Server chưa đặt ADMIN_TOKEN.", 500);
+    if (!isAdmin(request, env)) return fail("UNAUTHORIZED", "Sai mật khẩu quản trị.", 401);
+
+    if (path === "/admin/license/list") {
+        const { results } = await env.DB.prepare("SELECT * FROM licenses ORDER BY id DESC LIMIT 300").all();
+        return json({ ok: true, licenses: results.map(publicRow) });
+    }
+    const body = await readBody(request);
+    if (path === "/admin/license/create") {
+        if (!PLANS[body.plan]) return fail("BAD_REQUEST", "Gói không hợp lệ (3d, 3m, 6m, 1y).");
+        const count = Math.max(1, Math.min(50, parseInt(body.count, 10) || 1));
+        const note = String(body.note || "").slice(0, 100);
+        let machine = null;
+        if (body.machine) { machine = normalizeMachine(body.machine); if (!machine) return fail("BAD_REQUEST", "Mã máy không hợp lệ."); }
+        const keys = [];
+        for (let i = 0; i < count; i++) {
+            const key = randomKey();
+            const hash = await sha256Hex(key);
+            const r = await env.DB.prepare("INSERT INTO licenses (key_hash, key_hint, plan, note, status, machine, created_at) VALUES (?, ?, ?, ?, 'unused', ?, ?)")
+                .bind(hash, key.slice(-4), body.plan, note, machine, Date.now()).run();
+            keys.push({ key, plan: body.plan, id: r && r.meta ? r.meta.last_row_id : null });
+        }
+        return json({ ok: true, keys });
+    }
+    const id = parseInt(body.id, 10);
+    if (!id) return fail("BAD_REQUEST", "Thiếu id.");
+    if (path === "/admin/license/revoke") {
+        const r = await env.DB.prepare("UPDATE licenses SET status='revoked' WHERE id=?").bind(id).run();
+        return json({ ok: true, changed: r.meta.changes });
+    }
+    if (path === "/admin/license/restore") {
+        const r = await env.DB.prepare("UPDATE licenses SET status = CASE WHEN activated_at IS NULL THEN 'unused' ELSE 'active' END WHERE id=? AND status='revoked'").bind(id).run();
+        return json({ ok: true, changed: r.meta.changes });
+    }
+    if (path === "/admin/license/unbind") { // đổi máy: gỡ máy cũ, giữ nguyên hạn dùng
+        const r = await env.DB.prepare("UPDATE licenses SET machine=NULL WHERE id=? AND status != 'revoked'").bind(id).run();
+        return json({ ok: true, changed: r.meta.changes });
+    }
+    return fail("NOT_FOUND", "Không có chức năng này.", 404);
+}
+
+export default {
+    async fetch(request, env) {
+        if (request.method === "OPTIONS") return new Response(null, { headers: CORS });
+        const path = new URL(request.url).pathname;
+        try {
+            if (path === "/health") return json({ ok: true, service: "menu-license", time: Date.now() });
+            if (request.method === "POST" && path === "/license/activate") return await handleActivate(request, env);
+            if (request.method === "POST" && path === "/license/check") return await handleCheck(request, env);
+            if (path.indexOf("/admin/license/") === 0) return await handleAdmin(path, request, env);
+            return fail("NOT_FOUND", "Không có chức năng này.", 404);
+        } catch (err) {
+            console.error("license worker error:", err && err.message);
+            return fail("SERVER_ERROR", "Lỗi server, thử lại sau.", 500);
+        }
+    }
+};
+
+export { normalizeKey, normalizeMachine, addPlan, randomKey };
