+  const st1 = m1.getStatus();
+  ok(st1.plan === '3m' && st1.daysLeft >= 88 && st1.keyHint === k3m.slice(-4) && !JSON.stringify(st1).includes(k3m), 'trạng thái: gói 3 tháng, ~90 ngày, chỉ lộ 4 số cuối key');
