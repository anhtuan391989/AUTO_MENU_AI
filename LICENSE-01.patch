+<!DOCTYPE html>
+<html lang="vi">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>MENU — Tạo & quản lý key License</title>
+<style>
+  body{font-family:Segoe UI,Arial,sans-serif;background:#0b1220;color:#dbe7f5;max-width:980px;margin:24px auto;padding:0 16px;line-height:1.5}
+  h1{font-size:20px} h2{font-size:16px;margin-top:24px}
+  .box{background:#111c30;border:1px solid #23406b;border-radius:8px;padding:14px;margin:12px 0}
+  label{display:block;font-size:13px;color:#9db4d1;margin:8px 0 3px}
+  input,select{width:100%;box-sizing:border-box;background:#0a1626;color:#e6f2ff;border:1px solid #23406b;border-radius:6px;padding:8px;font-size:14px}
+  .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
+  button{background:#0e4d7a;color:#fff;border:0;border-radius:6px;padding:8px 13px;cursor:pointer;font-size:13px;margin:4px 6px 4px 0}
+  button:hover{background:#136aa8} button.red{background:#7a2a2a} button.red:hover{background:#a33a3a}
+  table{width:100%;border-collapse:collapse;font-size:13px} th,td{border-bottom:1px solid #23406b;padding:6px 8px;text-align:left}
+  code{color:#9fe3ff;font-family:Consolas,monospace} .good{color:#7dffb0} .bad{color:#ff8a8a} .warn{color:#ffd37a}
+  .newkey{font-size:16px;letter-spacing:1px;padding:6px 0}
+</style>
+</head>
+<body>
+<h1>Tạo & quản lý key License</h1>
+<p class="warn">Chỉ mở trang này trên máy của bạn. Mật khẩu quản trị chỉ nhập vào đây, không ai khác cần biết.</p>
+
+<div class="box">
+  <div class="row">
+    <div><label>Địa chỉ server License (không có dấu / cuối)</label>
+      <input id="server" placeholder="https://menu-license-server.TEN-BAN.workers.dev"></div>
+    <div><label>Mật khẩu quản trị (ADMIN_TOKEN)</label>
+      <input id="token" type="password" autocomplete="off"></div>
+  </div>
+</div>
+
+<h2>Tạo key mới</h2>
+<div class="box">
+  <div class="row">
+    <div><label>Gói</label>
+      <select id="plan"><option value="3d">3 ngày</option><option value="3m">3 tháng</option><option value="6m">6 tháng</option><option value="1y">1 năm</option></select></div>
+    <div><label>Số lượng</label><input id="count" type="number" min="1" max="50" value="1"></div>
+  </div>
+  <div class="row">
+    <div><label>Ghi chú (tên khách…)</label><input id="note" maxlength="100"></div>
+    <div><label>Mã máy của khách (không bắt buộc — nhập thì key chỉ chạy đúng máy đó)</label><input id="machine" placeholder="XXXXX-XXXXX-XXXXX-XXXXX"></div>
+  </div>
+  <button id="btnCreate">Tạo key</button>
+  <div id="created"></div>
+</div>
+
+<h2>Danh sách key <button id="btnList">Tải lại</button></h2>
+<div class="box"><div id="msg"></div>
+<table><thead><tr><th>#</th><th>Key (4 số cuối)</th><th>Gói</th><th>Ghi chú</th><th>Trạng thái</th><th>Mã máy</th><th>Hết hạn</th><th></th></tr></thead>
+<tbody id="rows"></tbody></table></div>
+
+<script>
+  const $ = (id) => document.getElementById(id);
+  const PLAN = { '3d': '3 ngày', '3m': '3 tháng', '6m': '6 tháng', '1y': '1 năm' };
+  const STATUS = { unused: 'Chưa dùng', active: 'Đang dùng', revoked: 'Đã thu hồi' };
+  try { $('server').value = localStorage.getItem('menuLicenseServer') || ''; } catch (_) {}
+
+  function base() { const u = $('server').value.trim().replace(/\/+$/, ''); try { localStorage.setItem('menuLicenseServer', u); } catch (_) {} return u; }
+  function say(t, cls) { $('msg').textContent = t || ''; $('msg').className = cls || ''; }
+  async function call(path, body) {
+    const r = await fetch(base() + path, {
+      method: body === undefined ? 'GET' : 'POST',
+      headers: { 'Authorization': 'Bearer ' + $('token').value.trim(), 'Content-Type': 'application/json' },
+      body: body === undefined ? undefined : JSON.stringify(body)
+    });
+    return await r.json();
+  }
+  function fmt(ts) { return ts ? new Date(ts).toLocaleString('vi-VN') : '—'; }
+
+  async function load() {
+    say('Đang tải…');
+    try {
+      const r = await call('/admin/license/list');
+      if (!r.ok) { say(r.message || 'Lỗi', 'bad'); return; }
+      say('Có ' + r.licenses.length + ' key.', 'good');
+      const tb = $('rows'); tb.textContent = '';
+      for (const l of r.licenses) {
+        const tr = document.createElement('tr');
+        const cells = [l.id, '…' + l.hint, PLAN[l.plan] || l.plan, l.note, STATUS[l.status] || l.status, l.machine || '—', fmt(l.expiresAt)];
+        for (const c of cells) { const td = document.createElement('td'); td.textContent = c; tr.appendChild(td); }
+        const act = document.createElement('td');
+        const add = (label, path, cls) => { const b = document.createElement('button'); b.textContent = label; if (cls) b.className = cls;
+          b.onclick = async () => { if (!confirm(label + ' key #' + l.id + '?')) return; const x = await call(path, { id: l.id }); say(x.ok ? 'Xong.' : (x.message || 'Lỗi'), x.ok ? 'good' : 'bad'); load(); };
+          act.appendChild(b); };
+        if (l.status !== 'revoked') { add('Thu hồi', '/admin/license/revoke', 'red'); if (l.machine) add('Đổi máy', '/admin/license/unbind'); }
+        else add('Khôi phục', '/admin/license/restore');
+        tr.appendChild(act); tb.appendChild(tr);
+      }
+    } catch (e) { say('Không kết nối được server: ' + e.message, 'bad'); }
+  }
+
+  $('btnList').onclick = load;
+  $('btnCreate').onclick = async () => {
+    $('created').textContent = '';
+    try {
+      const body = { plan: $('plan').value, count: parseInt($('count').value, 10) || 1, note: $('note').value.trim() };
+      const m = $('machine').value.trim(); if (m) body.machine = m;
+      const r = await call('/admin/license/create', body);
+      if (!r.ok) { $('created').textContent = r.message || 'Lỗi'; $('created').className = 'bad'; return; }
+      $('created').className = 'good'; $('created').textContent = 'Đã tạo. Key chỉ hiện đầy đủ ở lần này — hãy sao chép ngay:';
+      for (const k of r.keys) {
+        const d = document.createElement('div'); d.className = 'newkey';
+        const c = document.createElement('code'); c.textContent = k.key; d.appendChild(c);
+        const b = document.createElement('button'); b.textContent = 'Sao chép';
+        b.onclick = () => navigator.clipboard.writeText(k.key); d.appendChild(b);
+        $('created').appendChild(d);
+      }
+      load();
+    } catch (e) { $('created').textContent = 'Không kết nối được server: ' + e.message; $('created').className = 'bad'; }
+  };
+</script>
+</body>
+</html>
