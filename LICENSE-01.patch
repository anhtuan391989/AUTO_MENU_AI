+  ok((await m1.activate(k3m)).reason === 'NETWORK' && !m1.isLicensed(), 'mất mạng lúc kích hoạt -> báo lỗi mạng, vẫn khoá');
+  netDown = false;
+  const r1 = await m1.activate(k3m.toLowerCase());
