+    setInterval(() => { ctl.tick(); }, 100); // FX-AUTO-TOGGLE-02: luôn theo dõi nhạc; có gửi lệnh hay không do isEnabled (ô tích) quyết định // ĐÚNG 1 interval cho cả vòng đời trang
     return ctl;
 }
