+    ok((ren.match(/setInterval\(\(\) => \{ ctl\.tick\(\); \}, 100\)/g) || []).length === 1 && /if \(window\.__fxAuto \|\| /.test(ren), '11. Wiring: đúng 1 setInterval và có chốt chống tạo controller thứ hai');
