+
+                if (total <= LOGS_TOTAL_CAP_BYTES) break;
+                if (f.full === this.currentFilePath) continue; // không xoá file đang ghi dở
+
+                fs.unlinkSync(f.full);
+                total -= f.size;
+
+            }
