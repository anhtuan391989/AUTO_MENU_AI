+    _pruneOldestIfOverCap() {
+
+        try {
+
+            const files = fs.readdirSync(LOGS_DIR)
+                .filter((f) => f.endsWith(".jsonl"))
+                .map((f) => {
+                    const full = path.join(LOGS_DIR, f);
+                    const st = fs.statSync(full);
+                    return { full, size: st.size, mtimeMs: st.mtimeMs };
