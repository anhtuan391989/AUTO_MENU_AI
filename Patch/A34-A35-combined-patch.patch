+    // không phản ánh đúng tình huống thật mà TEST C/E cần kiểm tra).
+    "D Minor": [73.4, 146.8, 349.2, 440.0, 587.3],       // D2(bass) + D3,F4,A4,D5 (hoà âm trên)
+    "D# Minor": [77.8, 155.6, 370.0, 466.2, 622.3],      // D#2(bass) + D#3,F#4,A#4,D#5
