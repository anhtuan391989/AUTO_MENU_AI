+    check(winnerAt === null, `Hợp âm mập mờ KHÔNG bị khoá dù đã chờ đủ 16s (vượt cả sàn vote-window) (thực tế: ${winnerAt === null ? "chưa khoá — ĐÚNG" : `đã khoá "${winnerKey}" lúc ${winnerAt}ms — SAI`})`);
