+    check(winnerAt === null, `Hợp âm mập mờ (thiếu quãng 3) KHÔNG bị Fast Path khoá nhầm trong 1.9s (thực tế: ${winnerAt === null ? "chưa khoá — ĐÚNG" : `đã khoá "${winnerKey}" lúc ${winnerAt}ms — SAI, tái hiện đúng bug Khói báo`})`);
