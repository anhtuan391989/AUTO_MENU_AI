+    check(uniqueKeys.length <= 1, `Chỉ báo TỐI ĐA 1 Key duy nhất trong suốt 20s tín hiệu ổn định (thực tế: ${JSON.stringify(uniqueKeys)})`);
+    if (uniqueKeys.length === 1) {
