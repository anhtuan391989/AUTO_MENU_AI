+        setStatus: (id, s) => log.status.push([id, s]), formatCountdownMMSS: () => "04:00", logKeySource() {}, refreshKeySourceDisplay() {},
+        reportManualStateSnapshot() {}, saveData() {}, recordModStage() {}, isAiControlActive: () => false,
