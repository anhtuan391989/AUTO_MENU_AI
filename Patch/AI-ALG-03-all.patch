 // đúng giá trị nào, thay vì ép cứng về 0.
 let aiSemitoneOffset = 0;
 
+// TASK AI-ALG-03 (D6) — CHUỖI TRẠNG THÁI modulation -> hành động, CHỈ để quan sát/chẩn đoán (không đổi UI, không đổi lệnh gửi).
