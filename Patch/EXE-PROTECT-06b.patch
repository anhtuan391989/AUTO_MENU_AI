From 408717167821c6b0767b8651fe8a4e1251d32d62 Mon Sep 17 00:00:00 2001
From: Claude A <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 14:10:00 +0000
Subject: [PATCH] EXE-PROTECT-06b: build-protected.bat tu cai thu vien lam roi
 khi thieu

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Y3Me4YGLz39DbK1HnaR9zx
---
 tools/build-protected.bat | 7 ++++++-
 tools/build-protected.js  | 2 +-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/tools/build-protected.bat b/tools/build-protected.bat
index 3986c15..d591735 100644
--- a/tools/build-protected.bat
+++ b/tools/build-protected.bat
@@ -9,7 +9,12 @@ if errorlevel 1 (
 )
 if not exist "node_modules\javascript-obfuscator" (
   echo Dang cai thu vien lam roi code ^(chi lan dau^)...
-  call npm install
+  call npm install --no-save javascript-obfuscator@4.1.1
+)
+if not exist "node_modules\javascript-obfuscator" (
+  echo KHONG cai duoc thu vien lam roi code. Kiem tra mang roi chay lai.
+  pause
+  exit /b 1
 )
 node tools\build-protected.js %*
 echo.
diff --git a/tools/build-protected.js b/tools/build-protected.js
index 7d6b3dc..da5cae6 100644
--- a/tools/build-protected.js
+++ b/tools/build-protected.js
@@ -96,7 +96,7 @@ function main(argv) {
     const si = argv.indexOf("--stage");
     const stage = si >= 0 && argv[si + 1] ? path.resolve(argv[si + 1]) : path.join(os.tmpdir(), "automenu-stage");
     const Obf = loadObfuscator(ROOT);
-    if (!Obf) { console.error("Chưa cài thư viện làm rối. Hãy chạy:  npm install   (trong thư mục dự án) rồi chạy lại."); return 1; }
+    if (!Obf) { console.error("Chưa cài thư viện làm rối. Hãy chạy:  npm install --no-save javascript-obfuscator@4.1.1   (trong thư mục dự án) rồi chạy lại."); return 1; }
     console.log("1/3 Chép dự án sang thư mục tạm: " + stage);
     makeStage(stage, { withTests });
     console.log("2/3 Làm rối code app/ và core/ ...");
