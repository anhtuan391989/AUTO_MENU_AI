+            async first() {
+                if (q.startsWith('SELECT song_id as songId, total_duration_sec as totalSec FROM song_info WHERE song_id = ?')) {
+                    const s = songs.find((x) => x.songId === args[0]);
+                    return s ? { songId: s.songId, totalSec: s.dur || null } : null;
