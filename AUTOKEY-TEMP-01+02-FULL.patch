+            const f = k / (N_FFT * d);
+            if (f >= FREQ_MIN && f <= FREQ_MAX) {
+                const midi = 69.0 + 12.0 * Math.log2(f / 440.0);
+                const n = ((roundHalfEven(midi) % 12) + 12) % 12;
