+    function pearsonCorr(x, y) {
+        let mx = 0, my = 0;
+        for (let i = 0; i < 12; i++) { mx += x[i]; my += y[i]; }
+        mx /= 12; my /= 12;
+        let sxx = 0, syy = 0, sxy = 0;
+        for (let i = 0; i < 12; i++) { const a = x[i] - mx, b = y[i] - my; sxx += a * a; syy += b * b; sxy += a * b; }
