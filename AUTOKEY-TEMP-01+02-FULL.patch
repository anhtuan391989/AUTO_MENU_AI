+        binTableCache[sr] = t;
+        return t;
+    }
+
+    // extract_chunk_features: trả { full: Float64Array(12), bass: Float64Array(12) } hoặc null (im lặng / không có năng lượng)
+    function extractChunkFeatures(audio, sr) {
+        const len0 = audio.length;
