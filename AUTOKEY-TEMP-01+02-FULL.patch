+
+    // Cắt luồng PCM (mono) thành đoạn 1.5 s: đọc từng khối 50 ms, khối im lặng (RMS < 0.001) bị bỏ qua (KHÔNG xoá bộ đệm).
+    function createChunker(sampleRate, onChunk) {
